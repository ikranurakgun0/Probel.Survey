@{
    Layout = "_LayoutBos";
}

<div class="text-center mb-4">
    <div class="pb-bos-logo"><i class="bi bi-activity"></i></div>
    <h4 class="mb-1">Probel'e Hoş Geldiniz</h4>
    <p class="text-muted small mb-0">Devam etmek için giriş yapın</p>
</div>

<div class="pb-card pb-auth-card" style="max-width:380px;margin:0 auto;">
    <form method="post">
        <div class="mb-3">
            <label class="small text-muted">Kullanıcı Adı</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input type="text" name="kullaniciAdi" class="form-control" autofocus />
            </div>
        </div>
        <div class="mb-3">
            <label class="small text-muted">Şifre</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input type="password" name="sifre" class="form-control" />
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-2" style="padding:0.6rem;">
            <i class="bi bi-box-arrow-in-right"></i> Giriş Yap
        </button>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mt-3 mb-0 py-2 small">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p class="mb-0">@error.ErrorMessage</p>
            }
        </div>
        <p class="text-center text-muted small mt-3 mb-0">
            Şifrenizi mi unuttunuz? <br />Sistem yöneticinizle iletişime geçin.
        </p>
    }
</div>