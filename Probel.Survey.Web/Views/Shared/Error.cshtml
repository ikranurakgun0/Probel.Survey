@model ErrorViewModel
@{
    Layout = "_LayoutBos";
    ViewData["Title"] = "Bir Hata Oluştu";
}

<div class="text-center" style="padding-top:3rem;">
    <div class="pb-bos-logo" style="background:var(--pb-danger);width:64px;height:64px;font-size:1.8rem;">
        <i class="bi bi-exclamation-lg"></i>
    </div>
    <h4 class="mt-3">Bir şeyler ters gitti</h4>
    <p class="text-muted">
        İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen tekrar deneyin veya
        sorun devam ederse sistem yöneticinizle iletişime geçin.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">
            Başvuru No: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Anket" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-house"></i> Ana Sayfaya Dön
    </a>
</div>
