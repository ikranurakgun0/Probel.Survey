<h2 class="mb-3"><i class="bi bi-person-plus"></i> Yeni Kullanıcı Ekle</h2>

<div class="pb-card" style="max-width:420px;">
    <form method="post">
        <div class="mb-3">
            <label class="small text-muted">Kullanıcı Adı</label>
            <input type="text" name="kullaniciAdi" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="small text-muted">Ad Soyad</label>
            <input type="text" name="adSoyad" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="small text-muted">Şifre</label>
            <input type="password" name="sifre" class="form-control" />
        </div>
        <div class="mb-3 form-check">
            <input type="checkbox" name="yoneticiMi" value="true" class="form-check-input" id="yoneticiMi" />
            <label class="form-check-label" for="yoneticiMi">Yönetici yetkisi ver</label>
        </div>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Kaydet
        </button>
    </form>

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger mt-3 mb-0">@TempData["Hata"]</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mt-3 mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p class="mb-0">@error.ErrorMessage</p>
            }
        </div>
    }
</div>