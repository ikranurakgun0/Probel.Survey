@model IReadOnlyList<Probel.Survey.Application.Kullanicilar.KullaniciListeDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-people"></i> Kullanıcılar</h2>
    @if (User.IsInRole("Yonetici"))
    {
        <a asp-action="Ekle" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Kullanıcı
        </a>
    }
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success">@TempData["Mesaj"]</div>
}

<div class="pb-card">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Kullanıcı Adı</th>
                <th>Ad Soyad</th>
                <th>Rol</th>
                <th>Durum</th>
                @if (User.IsInRole("Yonetici"))
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var k in Model)
            {
                <tr>
                    <td class="fw-semibold">@k.KullaniciAdi</td>
                    <td>@k.AdSoyad</td>
                    <td>
                        @if (k.YoneticiMi)
                        {
                            <span class="badge" style="background:var(--pb-accent-soft);color:var(--pb-accent);">Yönetici</span>
                        }
                        else
                        {
                            <span class="text-muted small">Kullanıcı</span>
                        }
                    </td>
                    <td>
                        @if (k.AktifMi)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge" style="background:#EDEEF2;color:#6B7280;">Pasif</span>
                        }
                    </td>
                    @if (User.IsInRole("Yonetici"))
                    {
                        <td>
                            @if (k.AktifMi && !k.YoneticiMi)
                            {
                                <form asp-action="Pasiflestir" asp-route-id="@k.Id" method="post"
                                      data-confirm="Bu kullanıcıyı pasifleştirmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-person-dash"></i> Pasifleştir
                                    </button>
                                </form>
                            }
                            else if (!k.AktifMi)
                            {
                                <form asp-action="Aktiflestir" asp-route-id="@k.Id" method="post"
                                      data-confirm="Bu kullanıcıyı tekrar aktifleştirmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-person-check"></i> Aktifleştir
                                    </button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>