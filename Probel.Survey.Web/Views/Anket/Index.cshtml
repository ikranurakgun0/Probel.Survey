@model IReadOnlyList<Probel.Survey.Application.Anketler.AnketListeDto>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success">@TempData["Mesaj"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Anketler</h2>
    <a asp-action="Olustur" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Yeni Anket
    </a>
</div>

<div class="pb-card">
    @if (!Model.Any())
    {
        <p class="text-muted mb-0">Henüz hiç anket sürümü yok.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Anket Adı</th>
                    <th>Hizmet Türü</th>
                    <th>Sürüm</th>
                    <th>Durum</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.AnketAdi</td>
                        <td><span class="text-muted">@item.HizmetTuru</span></td>
                        <td>@item.SurumNo</td>
                        <td>
                            @if (item.Durum == "Yayinda")
                            {
                                <span class="badge bg-success">Yayında</span>
                            }
                            else if (item.Durum == "Arsiv")
                            {
                                <span class="badge" style="background:#EDEEF2;color:#6B7280;"><i class="bi bi-archive"></i> Arşivde</span>
                            }
                            else
                            {
                                <span class="badge" style="background:#EDEEF2;color:#6B7280;">Taslak</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Detay" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-right"></i> Detay
                            </a>
                        </td>
                        <td>
                            @if (item.Durum == "Taslak")
                            {
                                <form asp-action="Yayinla" asp-route-id="@item.Id" method="post" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-broadcast"></i> Yayınla
                                    </button>
                                </form>

                                <form asp-action="Sil" asp-route-id="@item.Id" method="post" style="display:inline"
                                      data-confirm="Bu anketi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                            else if (item.Durum == "Yayinda")
                            {
                                <form asp-action="Arsivle" asp-route-id="@item.Id" method="post" style="display:inline"
                                      data-confirm="Bu anketi arşivlemek istediğinize emin misiniz? Arşivlenen ankete yeni davet oluşturulamaz.">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-archive"></i> Arşivle
                                    </button>
                                </form>
                            }
                            else if (item.Durum == "Arsiv")
                            {
                                <form asp-action="Yayinla" asp-route-id="@item.Id" method="post" style="display:inline"
                                      data-confirm="Bu anketi tekrar yayına almak istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-arrow-counterclockwise"></i> Geri Al
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>