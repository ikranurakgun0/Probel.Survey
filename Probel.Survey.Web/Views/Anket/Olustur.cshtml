<h2 class="mb-3"><i class="bi bi-clipboard-plus"></i> Yeni Anket Oluştur</h2>

<div class="pb-card" style="max-width:420px;">
    <form method="post">
        <div class="mb-3">
            <label class="small text-muted">Anket Adı</label>
            <input type="text" name="ad" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="small text-muted">Hizmet Türü</label>
            <select name="hizmetTuru" class="form-select">
                <option value="">-- Seçiniz --</option>
                <option value="YATAN">Yatan</option>
                <option value="AYAKTAN">Ayaktan</option>
                <option value="ACIL">Acil</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Kaydet
        </button>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mt-3 mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p class="mb-0">@error.ErrorMessage</p>
            }
        </div>
    }
</div>