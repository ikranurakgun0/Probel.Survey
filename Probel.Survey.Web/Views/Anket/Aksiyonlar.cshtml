@model IReadOnlyList<Probel.Survey.Application.Anketler.AksiyonListeDto>

<h2 class="mb-3"><i class="bi bi-exclamation-triangle"></i> Aksiyonlar</h2>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success">@TempData["Mesaj"]</div>
}

<div class="pb-card">
    @if (!Model.Any())
    {
        <p class="text-muted mb-0">Henüz hiç aksiyon açılmamış.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Soru</th>
                    <th>Açıklama</th>
                    <th>Hedef Tarih</th>
                    <th>Durum</th>
                    <th>Değiştir</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.SoruMetni</td>
                        <td>@a.Aciklama</td>
                        <td>@(a.HedefTarih?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td>
                            @{
                                var renk = a.Durum switch
                                {
                                    "Acik" => "background:#FCEAEA;color:var(--pb-danger);",
                                    "DevamEdiyor" => "background:#FFF6E5;color:var(--pb-warning);",
                                    _ => "background:#E5F7F0;color:var(--pb-success);"
                                };
                            }
                            <span class="badge" style="@renk">@a.Durum</span>
                        </td>
                        <td>
                            <form asp-action="AksiyonDurumGuncelle" method="post" class="d-flex gap-2">
                                <input type="hidden" name="aksiyonId" value="@a.Id" />
                                <select name="yeniDurum" class="form-select form-select-sm">
                                    <option value="Acik" selected="@(a.Durum == "Acik")">Açık</option>
                                    <option value="DevamEdiyor" selected="@(a.Durum == "DevamEdiyor")">Devam Ediyor</option>
                                    <option value="Kapandi" selected="@(a.Durum == "Kapandi")">Kapandı</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Güncelle</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<a asp-action="Index" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Anket listesine dön
</a>